{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Import — Configure"|t('transport') %}

{% set actionLabels = {
    add: "Add"|t('transport'),
    update: "Update"|t('transport'),
    unchanged: "Unchanged"|t('transport'),
} %}
{% set actionColors = { add: 'green', update: 'orange', unchanged: 'light' } %}

{% block content %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        <input type="hidden" name="action" value="transport/import/preview">
        <input type="hidden" name="token" value="{{ token }}">

        {% if validation.errors|length %}
            <div class="pane warning transport-callout" role="alert">
                <p class="error has-icon">
                    <span class="icon" aria-hidden="true"></span>
                    <strong>{{ "Errors — import is blocked"|t('transport') }}</strong>
                </p>
                <ul class="errors">
                    {% for e in validation.errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}
        {% if validation.warnings|length %}
            <div class="pane warning transport-callout">
                <p class="warning has-icon">
                    <span class="icon" aria-hidden="true"></span>
                    <strong>{{ "Warnings"|t('transport') }}</strong>
                </p>
                <ul class="bullets">
                    {% for w in validation.warnings %}<li>{{ w }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="pane transport-callout">
            <strong>{{ "Summary"|t('transport') }}:</strong>
            {{ summary.add }} {{ "to add"|t('transport') }},
            {{ summary.update }} {{ "to update"|t('transport') }},
            {{ summary.unchanged }} {{ "unchanged"|t('transport') }}.
        </div>

        <p>
            <button type="button" class="btn" data-select-all>{{ "Select all"|t('transport') }}</button>
            <button type="button" class="btn" data-select-none>{{ "Select none"|t('transport') }}</button>
        </p>

        {% for key, diffs in groups %}
            <h2>{{ key|capitalize }} ({{ diffs|length }})</h2>
            <table class="data fullwidth transport-table">
                <thead>
                    <tr>
                        <th class="thin"></th>
                        <th>{{ "Title"|t('transport') }}</th>
                        <th>{{ "Action"|t('transport') }}</th>
                        <th>{{ "Changes"|t('transport') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for diff in diffs %}
                        <tr>
                            <td class="thin">
                                {{ forms.checkbox({
                                    name: 'uids[]',
                                    value: diff.uid,
                                    class: 'transport-select',
                                    checked: diff.action != 'unchanged',
                                    aria: { label: "Import {title}"|t('transport', { title: diff.title }) },
                                }) }}
                            </td>
                            <td>{{ diff.title }}</td>
                            <td>
                                <span class="status {{ actionColors[diff.action] }}"></span>
                                {{ actionLabels[diff.action] }}
                                {% if diff.matchedByNaturalKey %}
                                    <span class="light" data-icon="info"
                                        title="{{ 'This already exists here under a different UID. Importing updates it instead of adding a copy.'|t('transport') }}">
                                        {{ "matched existing"|t('transport') }}
                                    </span>
                                {% endif %}
                            </td>
                            <td>{{ diff.action == 'update' ? diff.changeCount : (diff.action == 'add' ? '—' : '0') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Preview changes"|t('transport') }}</button>
        </div>
    </form>

    {% css %}
        .transport-callout { margin-bottom: var(--l, 24px); }
        .transport-table { margin-bottom: var(--l, 24px); }
    {% endcss %}

    {% js %}
        document.querySelector('[data-select-all]')?.addEventListener('click', () => {
            document.querySelectorAll('.transport-select').forEach(c => c.checked = true);
        });
        document.querySelector('[data-select-none]')?.addEventListener('click', () => {
            document.querySelectorAll('.transport-select').forEach(c => c.checked = false);
        });
    {% endjs %}
{% endblock %}
