{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Import"|t('transport') %}

{% block content %}
    <form method="post" accept-charset="UTF-8" enctype="multipart/form-data">
        {{ csrfInput() }}
        <input type="hidden" name="action" value="transport/import/configure">

        <p>{{ "Upload a Transport package (.zip) to review and import its content into this environment."|t('transport') }}</p>

        {% set maxSize = craft.app.plugins.getPlugin('transport').settings.maxPackageSize %}
        {{ forms.field({
            label: "Package"|t('transport'),
            id: 'package',
            instructions: maxSize > 0 ? "Up to {max} MB."|t('transport', { max: maxSize }) : null,
            required: true,
        }, forms.file({
            id: 'package',
            name: 'package',
            inputAttributes: { accept: '.zip', required: true },
        })) }}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Review import"|t('transport') }}</button>
        </div>
    </form>
{% endblock %}
