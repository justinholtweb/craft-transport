{% extends "_layouts/cp" %}

{% set title = "#{record.direction|capitalize} ##{record.id}"|t('transport') %}
{% set crumbs = [{ label: "History"|t('transport'), url: url('transport/history') }] %}

{% block content %}
{% css %}
    .transport-mb { margin-bottom: var(--l, 24px); }
    .transport-mt { margin-top: var(--l, 24px); }
    .transport-mt-s { margin: var(--s, 12px) 0 0; }
    .transport-mt-0 { margin-top: 0; }
    .transport-m-0 { margin: 0; }
    .transport-cap { text-transform: capitalize; }
    .transport-stats { display: flex; flex-wrap: wrap; gap: var(--xl, 40px); }
    .transport-stat { font-size: 26px; font-weight: bold; line-height: 1.2; }
{% endcss %}

    <table class="data fullwidth transport-mb">
        <tbody>
            <tr><th>{{ "Date"|t('transport') }}</th><td>{{ record.dateCreated|datetime('short') }}</td></tr>
            <tr><th>{{ "Direction"|t('transport') }}</th><td>{{ record.direction }}</td></tr>
            <tr><th>{{ "Package"|t('transport') }}</th><td>{{ record.packageName }}</td></tr>
            <tr><th>{{ "Status"|t('transport') }}</th><td>{{ record.status }}</td></tr>
            <tr>
                <th>{{ "Elements"|t('transport') }}</th>
                <td>
                    {% for key, count in record.countsArray %}{{ key }}: {{ count }}{% if not loop.last %}, {% endif %}{% endfor %}
                </td>
            </tr>
            <tr><th>{{ "Snapshot"|t('transport') }}</th><td>{{ record.snapshotId ? "Available"|t('transport') : "—" }}</td></tr>
        </tbody>
    </table>

    {% if canDownload and record.direction == 'export' and packageAvailable and (currentUser.admin or record.userId == currentUser.id) %}
        <div class="buttons transport-mb">
            <a href="{{ url('transport/history/' ~ record.id ~ '/download') }}" class="btn submit">
                {{ "Download package"|t('transport') }}
            </a>
        </div>
    {% endif %}

    {% if report %}
        <h2>{{ "Report"|t('transport') }}</h2>
        {% include "transport/history/_report" with { report: report } only %}
    {% elseif errors|length %}
        <h2>{{ "Errors"|t('transport') }}</h2>
        <ul class="errors">
            {% for error in errors %}<li>{{ error }}</li>{% endfor %}
        </ul>
    {% endif %}

    {% if canRollback and record.direction == 'import' and record.snapshotId and record.status == 'completed' %}
        <form method="post" class="transport-mt">
            {{ csrfInput() }}
            <input type="hidden" name="action" value="transport/history/rollback">
            <input type="hidden" name="id" value="{{ record.id }}">
            <button type="submit" class="btn submit"
                data-confirm="{{ 'Roll back this import?'|t('transport') }}">
                {{ "Roll back this import"|t('transport') }}
            </button>
        </form>
    {% endif %}
{% endblock %}
