# Test-database credentials for the Codeception suite.
# Defaults target the ddev environment (`ddev exec ...`). These are local-only
# throwaway credentials — the `test` database is wiped on every run.
CRAFT_DB_DSN=mysql:host=db;port=3306;dbname=test
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=root
CRAFT_DB_TABLE_PREFIX=
CRAFT_DB_SCHEMA=
# MariaDB resolves the "utf8" alias to utf8mb3, which can't pair with Craft's
# default utf8mb4_unicode_ci collation — so be explicit.
CRAFT_DB_CHARSET=utf8mb4
CRAFT_DB_COLLATION=utf8mb4_unicode_ci

CRAFT_SECURITY_KEY=transport-test-security-key
